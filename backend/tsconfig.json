{
  "compilerOptions": {
    "target": "ES2023", "module": "Node16", "moduleResolution": "Node16",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "types": ["node"], "rootDir": ".", "outDir": "dist", "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.json", "server.js"],
  "exclude": ["node_modules", "dist", "src/**/*.test.js"]
}
