# Actual BFF/proxy peers only; empty = trust no forwarded addresses.
# Container bridge peer CIDRs must be measured on the deployment host.
TRUST_PROXY_CIDRS=
BIND_HOST=127.0.0.1
JWT_SECRET=
PORT=3000

# Match private Nuxt NUXT_BFF_BRIDGE_SECRET. Required for anonymous mutations.
BFF_BRIDGE_SECRET=

# Container paths are fixed by Compose; direct runs may use separate absolute paths.
# PUBLIC_DIR must not contain either database, backups or private state.
# DATA_DIR=/absolute/private/data
# PUBLIC_DIR=/absolute/private/data/public
# BACKUP_ROOT=/absolute/private/backups
# Existing bind mounts must be writable by the runtime UID (default 1000).

# Opt-in Bot platform: explicitly migrate main DB to v4 before enabling.
BOT_PLATFORM_ENABLED=false
# Optional: 64 hex characters (32 random bytes), independent from JWT/Webhook keys.
# Explicit main6 migration required. Keep and back up the key outside SQLite/public assets.
# BOT_CREDENTIAL_ENCRYPTION_KEY=
# Final HTTP(S) receiver URL; redirects are rejected. Leave empty to skip sending.
ASTRBOT_WEBHOOK_URL=
# Outbound webhook credential, distinct from Bot API service credentials.
ASTRBOT_TOKEN=
# Integer 1..30000; default 5000 milliseconds.
ASTRBOT_TIMEOUT_MS=5000
# Public origin serving /uploads to AstrBot (no path/query). Falls back to SITE_URL,
# then https://guatswr.top. Never inferred from an incoming Host header.
BOT_PUBLIC_ASSET_BASE_URL=
