{
  "name": "guiair-backend",
  "version": "1.0.0",
  "description": "Backend for GuiHangFeiXiangTian website",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --signal SIGTERM --watch src --watch server.js --ext js,ts,json --exec \"npm run build && node dist/server.js\"",
    "test:bootstrap": "node --test src/utils/eventContentStorage.test.js && node ../scripts/postgres/test-adapters.mjs --business --suite bootstrap",
    "test": "npm run build && node --test src/utils/eventContentStorage.test.js && node ../scripts/postgres/test-adapters.mjs --business --suite core",
    "test:unit": "npm run build && node --test src/utils/eventContentStorage.test.js && vitest run --configLoader native tests/unit",
    "test:integration": "npm run build && node ../scripts/postgres/test-adapters.mjs --business --suite integration",
    "test:contracts": "npm run build && node ../scripts/postgres/test-adapters.mjs --business --suite contracts",
    "test:bff": "npm run build && node ../scripts/postgres/test-adapters.mjs --business --suite bff",
    "test:ui": "npm run build && node ../scripts/postgres/test-adapters.mjs --business --suite ui",
    "check:legacy": "node scripts/check-legacy-budget.cjs",
    "build": "npm run check:legacy && node scripts/build.cjs",
    "typecheck": "npm run check:legacy && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "storage:cleanup": "node dist/src/storage/cleanup-cli.js",
    "admin:bootstrap": "node dist/src/admin/bootstrap-cli.js",
    "db:check": "node dist/src/migrations/postgres/cli.js check",
    "db:inspect": "node dist/src/migrations/postgres/cli.js check",
    "db:migrate": "node dist/src/migrations/postgres/cli.js",
    "db:postgres": "node dist/src/migrations/postgres/cli.js"
  },
  "dependencies": {
    "@guatswr/shared": "workspace:*",
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "7.2.0",
    "js-yaml": "4.3.2",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "nodemon": "3.1.14",
    "supertest": "7.3.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "private": true,
  "files": [
    "dist",
    "src",
    "docs",
    "scripts",
    "server.js",
    "legacy-javascript.json"
  ]
}
