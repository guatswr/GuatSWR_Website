{
  "name": "guiair-backend",
  "version": "1.0.0",
  "description": "Backend for GuiHangFeiXiangTian website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:bootstrap": "node --test --test-timeout=15000 tests/lifecycle.test.js src/utils/eventContentStorage.test.js",
    "test": "npm run test:bootstrap && vitest run --configLoader native",
    "test:unit": "npm run test:bootstrap && vitest run --configLoader native tests/unit",
    "test:integration": "vitest run --configLoader native tests/integration",
    "test:contracts": "vitest run --configLoader native tests/contracts",
    "test:bff": "vitest run --configLoader native --config vitest.bff.config.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "proxy-addr": "2.0.8",
    "sharp": "^0.33.5",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "tar": "^7.5.6",
    "node-gyp": "^12.1.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.16.0 <25"
  }
}
