{
  "name": "@guatswr/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3100",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:performance": "node scripts/performance.mjs"
  },
  "dependencies": {
    "@guatswr/shared": "workspace:*",
    "@nuxtjs/mdc": "0.23.2",
    "@nuxtjs/seo": "6.0.1",
    "@pinia/nuxt": "1.0.3",
    "nuxt": "4.6.2",
    "nuxt-auth-utils": "0.5.32",
    "nuxt-security": "2.6.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.0",
    "eslint": "10.13.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
