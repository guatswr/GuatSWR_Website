# Private Nitro-to-existing-backend origin. No /api suffix; never put this in public runtime config.
NUXT_API_BASE=http://127.0.0.1:8088
# Set a random secret of at least 32 characters in the deployment secret store.
# Production output does not read .env; inject these values into the process.
NUXT_SESSION_PASSWORD=
PORT=3100
HOST=127.0.0.1

# Canonical production site. Staging must override ENV and INDEXABLE.
NUXT_SITE_URL=https://www.guatswr.top
NUXT_SITE_ENV=production
NUXT_SITE_INDEXABLE=true

# Private bridge key: match backend BFF_BRIDGE_SECRET (32+ random characters).
NUXT_BFF_BRIDGE_SECRET=

# Production BFF writes require the exact public HTTPS origin (JSON array).
NUXT_BFF_AUTH_ALLOWED_ORIGINS=["https://www.guatswr.top"]
# Direct Node deployment: set the actual reverse-proxy peer CIDRs here.
# Root Compose overrides this with its Docker bridge gateway address.
NUXT_BFF_AUTH_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
NUXT_BFF_AUTH_ALLOW_INSECURE_LOOPBACK_COOKIES=false

# Optional OpenList v3 integration for /resources (falls back to built-in demo archive when unset)
# NUXT_OPENLIST_BASE_URL=https://pan.guatswr.top
# NUXT_OPENLIST_PUBLIC_URL=https://pan.guatswr.top
# NUXT_OPENLIST_TOKEN=
# NUXT_OPENLIST_ROOT_PATH=/
# NUXT_OPENLIST_TIMEOUT_MS=8000

# Optional private directory for temporary resource uploads; defaults to the OS temp directory.
NUXT_OPENLIST_UPLOAD_TEMP_DIR=

# Optional search engine & site verification meta tags (HTML <head>)
# Supports either a plain verification token or full <meta ... content="..." /> tag.
NUXT_PUBLIC_SITE_VERIFICATION_BAIDU=codeva-g9JIawSEQ3
# NUXT_PUBLIC_SITE_VERIFICATION_GOOGLE=
# NUXT_PUBLIC_SITE_VERIFICATION_BING=
# NUXT_PUBLIC_SITE_VERIFICATION_SOGOU=
# NUXT_PUBLIC_SITE_VERIFICATION_SO=
# NUXT_PUBLIC_SITE_VERIFICATION_CUSTOM=
