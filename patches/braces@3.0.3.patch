diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..931b7856a3e267fd78600b96e5cfd3216c841c83
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,12 @@
+'use strict';
+
+// Bound parser nesting and every recursive AST walker, including AST inputs
+// supplied directly to compile/expand/stringify. This is not user-configurable.
+exports.MAX_DEPTH = 128;
+exports.checkDepth = depth => {
+  if (depth > exports.MAX_DEPTH) {
+    const error = new SyntaxError('Brace nesting exceeds maximum depth (128)');
+    error.code = 'ERR_BRACES_MAX_DEPTH';
+    throw error;
+  }
+};
