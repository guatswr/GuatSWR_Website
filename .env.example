# Backend
SUPER_ADMIN_USERNAME=站长用户名
SUPER_ADMIN_PASSWORD=站长密码
PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_strong_secret
TWOFA_SECRET=replace_with_historical_secret_if_migrating
CORS_ORIGINS=https://www.guatswr.top
SITE_URL=https://www.guatswr.top
MAX_BODY_SIZE=50mb
STAGING_TTL_MS=172800000

# Optional
# SQLITE_PATH=/home/app/data/app.db
# LOG_LEVEL=info

# Umami Analytics (Unified Stack in docker-compose.yml)
# UMAMI_IMAGE=ghcr.nju.edu.cn/umami-software/umami@sha256:e69d1a7932e9dab0fc523edc7be1f3a53f3c261f57856fc2167ae74a8fc022e8
# UMAMI_DB_PASSWORD=your_secure_password
# UMAMI_HASH_SALT=your_consistent_salt
# UMAMI_PORT=13036
# UMAMI_BIND_ADDRESS=127.0.0.1
# UMAMI_DB_DATA_DIR=/opt/umami/umami-db-data
# UMAMI_GEO_DIR=/opt/umami/geo
