      "contains": "GUAT"
    },
    {
      "name": "readiness",
      "url": "https://www.guatswr.top/api/health/ready",
      "service": "guatswr-web"
    },
    {
      "name": "static-asset",
      "url": "https://www.guatswr.top/favicon.png",
