{
  "name": "@guatswr/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" } },
    "./config": { "import": { "types": "./dist/config.d.ts", "default": "./dist/config.js" }, "require": { "types": "./dist/cjs/config.d.ts", "default": "./dist/cjs/config.js" } },
    "./club-time": { "import": { "types": "./dist/club-time.d.ts", "default": "./dist/club-time.js" }, "require": { "types": "./dist/cjs/club-time.d.ts", "default": "./dist/cjs/club-time.js" } },
    "./event-labels": { "import": { "types": "./dist/event-labels.d.ts", "default": "./dist/event-labels.js" }, "require": { "types": "./dist/cjs/event-labels.d.ts", "default": "./dist/cjs/event-labels.js" } },
    "./admin-workflows": { "import": { "types": "./dist/admin-workflows.d.ts", "default": "./dist/admin-workflows.js" }, "require": { "types": "./dist/cjs/admin-workflows.d.ts", "default": "./dist/cjs/admin-workflows.js" } },
    "./backend-v1": { "import": { "types": "./dist/backend-v1.d.ts", "default": "./dist/backend-v1.js" }, "require": { "types": "./dist/cjs/backend-v1.d.ts", "default": "./dist/cjs/backend-v1.js" } },
    "./bot": { "import": { "types": "./dist/bot.d.ts", "default": "./dist/bot.js" }, "require": { "types": "./dist/cjs/bot.d.ts", "default": "./dist/cjs/bot.js" } }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run build && vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/build-cjs.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
